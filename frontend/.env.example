VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=أثر
VITE_DEFAULT_LANG=ar

# Optional — only for src/api/aiDirect.js (client-side prototype chat path).
# WARNING: this key ships inside the browser bundle and is publicly visible.
# Leave empty in production; the real chat flow proxies through the backend
# (VITE_API_BASE_URL -> /ai/chat) and never needs this.
VITE_ANTHROPIC_API_KEY=
